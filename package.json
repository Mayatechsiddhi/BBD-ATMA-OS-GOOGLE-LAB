{
  "name": "bbd-master-atma-os",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:integration": "node scripts/test-integration.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:generate:wasm": "node scripts/prisma-wasm.mjs generate",
    "db:migrate:wasm": "node scripts/prisma-wasm.mjs migrate",
    "test:http": "tsx --env-file=.env scripts/http-smoke.ts",
    "db:test:prepare": "node scripts/prepare-test-db.mjs",
    "licenses:inventory": "node scripts/license-inventory.mjs",
    "predev": "tsx --env-file-if-exists=.env scripts/check-env.ts development",
    "prestart": "tsx --env-file-if-exists=.env scripts/check-env.ts production",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "db:runtime:audit": "node --import tsx scripts/audit-local-runtime.mjs",
    "db:runtime:local": "node --import tsx scripts/configure-local-runtime.mjs",
    "test:privileges": "node scripts/test-runtime-privileges.mjs",
    "test:migrations": "node scripts/verify-rls-migrations.mjs",
    "test:pooler": "node scripts/test-pooler.mjs",
    "test:browser": "tsx --env-file=.env scripts/browser-invitations.ts",
    "test:load": "node scripts/test-integration.mjs tests/integration/contention.test.ts",
    "test:auth-proxy": "node scripts/test-auth-proxy.mjs",
    "db:readiness": "node --import tsx scripts/check-db-readiness.mjs",
    "db:grants:plan": "node --import tsx scripts/plan-runtime-grants.mjs",
    "test:migrations:fresh": "node scripts/verify-rls-migrations.mjs --fresh",
    "db:workforce:generate": "PRISMA_SCHEMA_PATH=prisma/workforce/schema.prisma node scripts/prisma-wasm.mjs generate",
    "db:workforce:test:prepare": "node --import tsx scripts/workforce/prepare-test.mjs",
    "test:workforce": "node scripts/workforce/test.mjs",
    "test:workforce:pooler": "node scripts/test-pooler.mjs --workforce"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.11",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.59.0",
    "next": "16.4.2",
    "nodemailer": "10.1.7",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@prisma/client-generator-ts": "7.10.1",
    "@prisma/internals": "7.10.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "playwright-core": "1.64.1",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "type": "module"
}
