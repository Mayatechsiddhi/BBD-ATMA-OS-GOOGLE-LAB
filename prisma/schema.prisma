generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  engineType = "client"
}
datasource db {
  provider = "postgresql"
}
model User {
  id String @id
  name String
  email String @unique
  emailVerified Boolean @default(false)
  image String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions Session[]
  accounts Account[]
  memberships Membership[]
}
model Session {
  id String @id
  expiresAt DateTime
  token String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId String
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  @@index([userId])
}
model Account {
  id String @id
  accountId String
  providerId String
  userId String
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  accessToken String?
  refreshToken String?
  idToken String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope String?
  password String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId])
  @@unique([providerId, accountId])
}
model Verification {
  id String @id
  identifier String
  value String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([identifier])
}
model RateLimit {
  id String @id
  key String @unique
  count Int
  lastRequest BigInt
}
enum Role {
  DISPLAY
  OWNER
  ADMIN
  MEMBER
}
model Organization {
  id String @id @default(cuid())
  name String
  slug String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  memberships Membership[]
  invitations Invitation[]
  auditEvents AuditEvent[]
  contacts Contact[]
  opportunities Opportunity[]
  clinicLeads ClinicLead[]
  appointments Appointment[]
  followUps FollowUp[]
  patients Patient[]
  doctors Doctor[]
  queueTokens QueueToken[]
}
model Membership {
  id String @id @default(cuid())
  organizationId String
  userId String
  role Role @default(MEMBER)
  createdAt DateTime @default(now())
  organization Organization @relation(fields:[organizationId], references:[id], onDelete:Cascade)
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  @@unique([organizationId,userId])
  @@index([userId])
}
model Invitation {
  id String @id @default(cuid())
  organizationId String
  email String
  role Role @default(MEMBER)
  tokenHash String @unique
  expiresAt DateTime
  acceptedAt DateTime?
  createdAt DateTime @default(now())
  organization Organization @relation(fields:[organizationId], references:[id], onDelete:Cascade)
  @@index([organizationId,email])
}
model AuditEvent {
  id String @id @default(cuid())
  organizationId String
  actorId String
  action String
  subjectId String?
  createdAt DateTime @default(now())
  organization Organization @relation(fields:[organizationId], references:[id], onDelete:Cascade)
  @@index([organizationId,createdAt])
}

enum ContactStatus {
  LEAD
  QUALIFIED
  CUSTOMER
  ARCHIVED
}
model Contact {
  id String @id @default(cuid())
  organizationId String
  name String
  email String
  company String?
  status ContactStatus @default(LEAD)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields:[organizationId], references:[id], onDelete:Cascade)
  opportunities Opportunity[]
  @@unique([organizationId,id])
  @@unique([organizationId,email])
  @@index([organizationId,status,createdAt])
}

model Opportunity {
  id String @id @default(cuid())
  organizationId String
  contactId String
  title String
  amountPaise Int
  stage String @default("OPEN")
  version Int @default(0)
  requestKey String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  organization Organization @relation(fields:[organizationId], references:[id], onDelete:Cascade)
  contact Contact @relation(fields:[organizationId,contactId], references:[organizationId,id], onDelete:Cascade, map:"Opportunity_contact_tenant_fkey")
  @@unique([organizationId,id])
  @@unique([organizationId,requestKey])
  @@index([organizationId,stage,createdAt,id])
}


enum ClinicLeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
}
enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
}
enum FollowUpStatus {
  OPEN
  DONE
  CANCELLED
}
model ClinicLead {
  id String @id @default(cuid())
  organizationId String
  name String
  phone String
  email String?
  source String
  status ClinicLeadStatus @default(NEW)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  followUps FollowUp[]
  patient Patient?
  @@unique([organizationId,id])
  @@index([organizationId,status,createdAt])
  @@index([organizationId,phone])
}
model Appointment {
  id String @id @default(cuid())
  organizationId String
  leadId String
  resource String
  startsAt DateTime @db.Timestamptz(3)
  endsAt DateTime @db.Timestamptz(3)
  status AppointmentStatus @default(SCHEDULED)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead ClinicLead @relation(fields: [organizationId,leadId], references: [organizationId,id], onDelete: Cascade, map: "Appointment_lead_tenant_fkey")
  queueTokens QueueToken[]
  @@unique([organizationId,id,leadId])
  @@unique([organizationId,id])
  @@index([organizationId,startsAt])
  @@index([organizationId,resource,startsAt])
}
model FollowUp {
  id String @id @default(cuid())
  organizationId String
  leadId String
  title String
  dueAt DateTime @db.Timestamptz(3)
  status FollowUpStatus @default(OPEN)
  completedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead ClinicLead @relation(fields: [organizationId,leadId], references: [organizationId,id], onDelete: Cascade, map: "FollowUp_lead_tenant_fkey")
  @@unique([organizationId,id])
  @@index([organizationId,status,dueAt])
}

model Patient {
  id String @id @default(cuid())
  organizationId String
  leadId String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  organization Organization @relation(fields:[organizationId], references:[id], onDelete:Cascade)
  lead ClinicLead @relation(fields:[organizationId,leadId], references:[organizationId,id], onDelete:Cascade)
  tokens QueueToken[]
  @@unique([organizationId,leadId])
  @@unique([organizationId,id])
  @@unique([organizationId,id,leadId])
}
model Doctor {
  id String @id @default(cuid())
  organizationId String
  name String
  room String
  resource String
  revision Int @default(0)
  schedule Json?
  scheduleVersion Int @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  organization Organization @relation(fields:[organizationId], references:[id], onDelete:Cascade)
  tokens QueueToken[]
  @@unique([organizationId,id])
  @@unique([organizationId,resource])
}
enum QueueStatus {
  WAITING
  CALLED
  SKIPPED
  COMPLETED
  CANCELLED
}
model QueueToken {
  id String @id @default(cuid())
  organizationId String
  patientId String
  leadId String
  doctorId String
  appointmentId String?
  day String
  number Int
  status QueueStatus @default(WAITING)
  callCount Int @default(0)
  calledAt DateTime? @db.Timestamptz(3)
  completedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  organization Organization @relation(fields:[organizationId], references:[id], onDelete:Cascade)
  patient Patient @relation(fields:[organizationId,patientId,leadId], references:[organizationId,id,leadId], onDelete:Cascade)
  doctor Doctor @relation(fields:[organizationId,doctorId], references:[organizationId,id], onDelete:Cascade)
  appointment Appointment? @relation(fields:[organizationId,appointmentId,leadId], references:[organizationId,id,leadId], onDelete:Cascade)
  @@unique([organizationId,id])
  @@unique([organizationId,day,number])
  @@index([organizationId,day,doctorId,status,number])
}
