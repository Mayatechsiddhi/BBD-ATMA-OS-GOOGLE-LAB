generator client {
 provider = "prisma-client"
 output = "../../src/generated/workforce"
 engineType = "client"
}
datasource db {
 provider = "postgresql"
}
model User {
  id String @id
  name String
  email String @unique
  emailVerified Boolean @default(false)
  image String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions Session[]
  accounts Account[]
}
model Session {
  id String @id
  expiresAt DateTime
  token String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId String
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  @@index([userId])
}
model Account {
  id String @id
  accountId String
  providerId String
  userId String
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  accessToken String?
  refreshToken String?
  idToken String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope String?
  password String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId])
  @@unique([providerId, accountId])
}
model Verification {
  id String @id
  identifier String
  value String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([identifier])
}
model RateLimit {
  id String @id
  key String @unique
  count Int
  lastRequest BigInt
}

model WorkforceCompany {
 id String @id @db.Uuid
 paused Boolean @default(false)
 version Int @default(0)
}
model WorkforceMember {
 companyId String @db.Uuid
 userId String
 role String
 active Boolean @default(true)
 version Int @default(0)
 @@id([companyId,userId])
}
model WorkforceTask {
 id String @db.Uuid
 companyId String @db.Uuid
 correlationId String @db.Uuid
 department String
 request Json
 digest String
 submittedBy String
 approverId String?
 approverVersion Int?
 founderId String?
 founderVersion Int?
 approvalId String? @db.Uuid
 approvalUntil DateTime? @db.Timestamptz(3)
 approvalState String @default("PENDING")
 status String @default("QUEUED")
 version Int @default(0)
 attempts Int @default(0)
 expiresAt DateTime @db.Timestamptz(3)
 result Json?
 @@id([companyId,id])
 @@unique([companyId,correlationId,department])
}
model WorkforceReceipt {
 id String @id @db.Uuid
 companyId String @db.Uuid
 taskId String @db.Uuid
 attempt Int
 executorId String
 approvalId String @db.Uuid
 digest String
 status String
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 finishedAt DateTime? @db.Timestamptz(3)
 @@unique([companyId,taskId,attempt])
}
model WorkforceAudit {
 subjectUserId String?
 id BigInt @id @default(autoincrement())
 companyId String @db.Uuid
 actorId String
 taskId String? @db.Uuid
 action String
 version Int
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 @@index([companyId,id])
}
